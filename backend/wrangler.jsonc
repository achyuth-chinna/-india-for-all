{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-for-all-research-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "india-for-all-research",
      "database_id": "722c6e57-f48b-4313-9e95-c2f0db1c9487"
    }
  ],
  "ratelimits": [
    {
      "name": "COMMUNITY_LIMITER",
      "namespace_id": "2026111401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "2026111402",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMITER",
      "namespace_id": "2026111403",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "2026111404",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
